import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression

from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix
)


# --------------------------------------------------
# 1. LOAD DATA
# --------------------------------------------------

df = pd.read_csv("customer_churn_day1.csv")


# --------------------------------------------------
# 2. UNDERSTAND DATA
# --------------------------------------------------

print(df.head())

print(df.shape)

print(df.info())

print(df.isnull().sum())


# --------------------------------------------------
# 3. CLEAN DATA
# --------------------------------------------------

df = df.drop_duplicates()

df["age"] = df["age"].fillna(
    df["age"].median()
)


# --------------------------------------------------
# 4. ENCODE CATEGORICAL DATA
# --------------------------------------------------

df = pd.get_dummies(
    df,
    columns=["contract_type"]
    # drop_first=True
)


# --------------------------------------------------
# 5. FEATURES AND TARGET
# --------------------------------------------------

X = df.drop("churn", axis=1)

y = df["churn"]


# --------------------------------------------------
# 6. TRAIN TEST SPLIT
# --------------------------------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)


# --------------------------------------------------
# 7. CREATE MODEL
# --------------------------------------------------

model = LogisticRegression(
    max_iter=1000
)


# --------------------------------------------------
# 8. TRAIN MODEL
# --------------------------------------------------

model.fit(
    X_train,
    y_train
)


# --------------------------------------------------
# 9. PREDICT
# --------------------------------------------------

predictions = model.predict(
    X_test
)


# --------------------------------------------------
# 10. EVALUATE
# --------------------------------------------------

print(
    "Accuracy:",
    accuracy_score(y_test, predictions)
)

print(
    confusion_matrix(
        y_test,
        predictions
    )
)

print(
    classification_report(
        y_test,
        predictions
    )
)